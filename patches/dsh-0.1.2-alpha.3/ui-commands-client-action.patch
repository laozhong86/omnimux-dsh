+  /** Start a session-owned client action without invoking the Host command executor. */
+  private startClientAction(
+    name: string,
+    spec: ClientActionSpec,
+    session: ClientSessionContext,
+    segment: TokenSegment,
+  ): void {
+    const id = session.sessionId
+    if (this.live.actions.has(id)) return
+    const actx = this.scopeFor(id)
+    if (actx === undefined) return
+    this.consumeVia(id, segment)
+    const active: ActiveClientAction = {
+      generation: ++this.actionGeneration,
+      abort: new AbortController(),
+      focusRestored: false,
+    }
+    this.live.actions.set(id, active)
+    this.live.actionScopes.set(id, actx)
+    actx.effect(() => () => this.clearOrAbortClientAction(id, active), 'command: session client action')
+    const context: ClientActionContext = {
+      session,
+      signal: active.abort.signal,
+      restoreComposerFocus: () => {
+        if (this.live.actions.get(id) !== active || active.abort.signal.aborted || active.focusRestored) return
+        active.focusRestored = true
+        this.focusHooks.get(id)?.()
+      },
+    }
+    let completion: Promise<void>
+    try {
+      completion = Promise.resolve(spec.run(context))
+    } catch (error) {
+      completion = Promise.reject(error)
+    }
+    void completion.then(
+      () => this.clearClientAction(id, active),
+      (error: unknown) => {
+        if (!active.abort.signal.aborted) {
+          this.noticeFor(id, 'error', error instanceof Error ? error.message : String(error || `/${name} failed`))
+        }
+        this.clearClientAction(id, active)
+      },
+    )
+  }
+
+  /** Monotonic owner token prevents an earlier action from clearing a successor. */
+  private actionGeneration = 0
+
+  private clearClientAction(id: SessionId, active: ActiveClientAction): void {
+    if (this.live.actions.get(id) !== active) return
+    this.live.actions.delete(id)
+    this.live.actionScopes.delete(id)
+  }
+
+  private clearOrAbortClientAction(id: SessionId, active: ActiveClientAction): void {
+    if (this.live.actions.get(id) !== active) return
+    active.abort.abort()
+    this.live.actions.delete(id)
+    this.live.actionScopes.delete(id)
+  }
+
+  private abortClientAction(id: SessionId): void {
+    const active = this.live.actions.get(id)
+    if (active !== undefined) this.clearOrAbortClientAction(id, active)
+  }

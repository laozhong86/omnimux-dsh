diff --git a/packages/client/runtime/src/client/sessions/failure-display.ts b/packages/client/runtime/src/client/sessions/failure-display.ts
index 88531f0857..4a890ea701 100644
--- a/packages/client/runtime/src/client/sessions/failure-display.ts
+++ b/packages/client/runtime/src/client/sessions/failure-display.ts
@@ -6,8 +6,25 @@
 export function displayFailureMessage(failure: unknown): string {
   if (failure === null || typeof failure !== 'object') return String(failure)
   const record = failure as { code?: unknown; message?: unknown }
+  const message = typeof record.message === 'string' ? record.message : ''
+  // Quota 403s are often stored as AUTH because the classifier saw the status
+  // before the wording. Prefer the account-balance reading whenever the text
+  // names an exhausted quota, so the GUI does not tell the user the key is bad.
+  if (record.code === 'QUOTA' || isQuotaFailureText(message)) {
+    return 'Account balance is too low for this request. Top up and try again.'
+  }
   // Provider AUTH messages may echo a masked or partially preserved credential.
   // Keep the raw diagnostic in the session log, but never project it into UI state.
   if (record.code === 'AUTH') return 'API key is invalid'
-  return typeof record.message === 'string' ? record.message : JSON.stringify(failure)
+  return message || JSON.stringify(failure)
+}
+
+/**
+ * Recognize exhausted-quota wording that may ride an AUTH-coded 403.
+ * @param detail - provider error text preserved on the failure.
+ */
+function isQuotaFailureText(detail: string): boolean {
+  return /\binsufficient[\s_-]+(?:user[\s_-]+)?(?:quota|balance|credits?)\b/i.test(detail)
+    || /\b(?:quota|usage[\s_-]+limit)[\s_-]+(?:exceeded|exhausted|reached)\b/i.test(detail)
+    || /预扣费额度失败/.test(detail)
 }
diff --git a/packages/client/runtime/tests/failure-display.client.spec.ts b/packages/client/runtime/tests/failure-display.client.spec.ts

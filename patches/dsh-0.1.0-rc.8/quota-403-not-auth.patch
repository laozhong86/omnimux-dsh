--- /dev/null
+++ b/packages/client/runtime/tests/failure-display.client.spec.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from 'vitest'
+import { displayFailureMessage } from '../src/client/sessions/failure-display.ts'
+
+describe('displayFailureMessage', () => {
+  it('keeps a real AUTH failure opaque', () => {
+    expect(displayFailureMessage({ code: 'AUTH', message: '401: Invalid token sk-abc' }))
+      .toBe('API key is invalid')
+  })
+
+  it('does not call a quota 403 an invalid API key', () => {
+    expect(displayFailureMessage({
+      code: 'AUTH',
+      message: '403: {"message":"预扣费额度失败, 用户剩余额度: Credits0.09","code":"insufficient_user_quota"}',
+    })).toBe('Account balance is too low for this request. Top up and try again.')
+  })
+
+  it('uses the same copy for an explicit QUOTA code', () => {
+    expect(displayFailureMessage({ code: 'QUOTA', message: 'out of credits' }))
+      .toBe('Account balance is too low for this request. Top up and try again.')
+  })
+})
\ No newline at end of file

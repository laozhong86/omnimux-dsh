{
  "name": "omnimux-dsh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "node scripts/omnimux.mjs dev",
    "sync": "node scripts/omnimux.mjs sync",
    "doctor": "node scripts/omnimux.mjs doctor",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:env": "bash scripts/dev-env.sh",
    "build:all": "node scripts/omnimux.mjs build:all",
    "lint:i18n": "node scripts/omnimux.mjs lint:i18n",
    "doc:lint": "node scripts/omnimux.mjs doc:lint",
    "doc:index": "node scripts/omnimux.mjs doc:index",
    "registry": "node scripts/omnimux.mjs registry",
    "registry:build": "node scripts/registry-tool.mjs build",
    "registry:verify": "node scripts/registry-tool.mjs verify",
    "stage": "node scripts/omnimux.mjs stage",
    "package:dev": "node scripts/omnimux.mjs package:dev",
    "omnimux": "node scripts/omnimux.mjs",
    "wt": "bash scripts/git-wt.sh",
    "wt:start": "bash scripts/git-wt.sh start",
    "wt:auto-start": "bash scripts/git-wt.sh auto-start",
    "wt:clean": "bash scripts/git-wt.sh clean",
    "wt:list": "bash scripts/git-wt.sh list",
    "wt:doctor": "bash scripts/git-wt.sh doctor",
    "qa:gate": "node scripts/auto-qa-gate.mjs",
    "note:lint": "node scripts/verify-agent-note-format.mjs",
    "doc:pairing": "node scripts/verify-bilingual-docs.mjs",
    "doc:pairing:write": "node scripts/verify-bilingual-docs.mjs --write",
    "archived:verify": "node scripts/verify-archived-agent-notes.mjs",
    "archived:seal": "node scripts/verify-archived-agent-notes.mjs --write",
    "check:boundaries": "node scripts/verify-plugin-boundaries.mjs",
    "test:gates": "node --test scripts/verify-ci-gates.test.mjs",
    "auto:run": "node scripts/auto-pipeline.mjs",
    "test": "pnpm --filter dsh-drama test && pnpm --filter omnimux test && pnpm --filter omnimux-accounts test && pnpm --filter omnimux-inspiration test && pnpm --filter omnimux-market test && pnpm test:gates",
    "test:all": "pnpm -r test && pnpm test:gates",
    "test:ui": "node scripts/scan-ui-gates.mjs",
    "test:e2e-mock": "OMNIMUX_MOCK_MODE=replay node scripts/mock-sidecar.test.mjs",
    "test:dx": "node scripts/test-dx-pipeline.mjs",
    "smoke": "bash scripts/smoke-drama.sh",
    "accept:apps": "bash scripts/accept-apps-install.sh",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:image-live": "node scripts/verify-omnimux-image-live.mjs",
    "verify:gates": "pnpm note:lint && pnpm doc:pairing && pnpm archived:verify && pnpm check:boundaries && pnpm test:gates",
    "verify:all": "pnpm verify:gates && pnpm test && pnpm registry:verify && pnpm doctor"
  }
}
